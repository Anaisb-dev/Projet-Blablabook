
# CONFIGURATION DU SERVEUR

# Port d'écoute du serveur Express
PORT=3000


# BASE DE DONNÉES

# URL de connexion PostgreSQL
# Format : postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BDD
# En local : localhost | En production : URL interne Render
DB_URL=postgres://USERNAME:PASSWORD@localhost:5432/DB_NAME


# API GOOGLE BOOKS

# Clé API Google Books (console.cloud.google.com)
GOOGLE_API_KEY=xxxxxxxxxxxxxxxx

# URL de base de l'API Google Books
GOOGLE_BASE_URL=https://www.googleapis.com/books/v1


# EMAILS (Resend)

# Adresse email expéditrice des notifications
EMAIL_USER=**********

# Mot de passe d'application Gmail (non utilisé si Resend est actif)
EMAIL_PASS=**********

# Clé API Resend pour l'envoi des emails transactionnels
# Inscription gratuite sur resend.com (100 emails/jour)
RESEND_API_KEY=**********


# AUTHENTIFICATION

# Clé secrète pour la signature des tokens JWT
# Doit être une chaîne longue et aléatoire en production
JWT_SECRET=**********


# FRONTEND

# URL de l'application frontend
# En local : http://localhost:5173
# En production : https://blablabook-client-pj37.onrender.com
FRONTEND_URL=http://localhost:5173